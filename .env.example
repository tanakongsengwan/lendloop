# ---------------------------------------------------------------------------
# Next.js app: copy to .env.local (git-ignored)
# ---------------------------------------------------------------------------
# Written by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk dashboard -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ---------------------------------------------------------------------------
# Convex deployment env vars: set with `npx convex env set NAME value`
# (they live in Convex, NOT in this file; listed here for reference)
# ---------------------------------------------------------------------------
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev   # Issuer of Clerk JWT template "convex"
# ADMIN_EMAILS=you@example.com,other@example.com                # verified emails that become admin
# APP_URL=http://localhost:3000                                 # used for links in notification emails
# N8N_REQUEST_WEBHOOK_URL=https://<public-n8n>/webhook/lendloop/request-created
# CONVEX_TO_N8N_SECRET=<openssl rand -hex 32>                   # signs Convex -> n8n
# N8N_TO_CONVEX_SECRET=<openssl rand -hex 32>                   # verifies n8n -> Convex

# n8n's own variables are in n8n/.env.example
