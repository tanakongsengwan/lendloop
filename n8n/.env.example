# Copy to n8n/.env (git-ignored). Read by docker-compose.yml.

# Random 32+ byte string; encrypts n8n credentials at rest. Keep it stable.
N8N_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# Convex -> n8n: verifies the request-created webhook. Same value as the
# Convex env var CONVEX_TO_N8N_SECRET.
CONVEX_TO_N8N_SECRET=change-me-openssl-rand-hex-32

# n8n -> Convex: signs calls to the Convex HTTP endpoints. Same value as the
# Convex env var N8N_TO_CONVEX_SECRET. Use a different value from the one above.
N8N_TO_CONVEX_SECRET=change-me-openssl-rand-hex-32

# Your Convex HTTP actions URL (ends in .convex.site; http://host.docker.internal:3211 for a local backend)
CONVEX_SITE_URL=https://your-deployment.convex.site

# Sender address for notification emails (SMTP credential is configured in the n8n UI)
LENDLOOP_FROM_EMAIL=lendloop@example.com
